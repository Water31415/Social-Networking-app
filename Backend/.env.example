# Copy to Backend/.env for local development; configure secrets on the host for production.
NODE_ENV=development
PORT=5000
DATABASE_API_KEY=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/snapit?retryWrites=true&w=majority
# Generate a real value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_API_KEY=
# Local expiry testing. Production defaults to 3600 unless explicitly overridden.
JWT_TTL_SECONDS=120
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LocationIQ forward/reverse geocoding.
MAP_API_KEY=
# Google Cloud Translation API v2.
GOOGLE_TRANSLATE_API_KEY=
# Optional, comma-separated resolver IPs; normally leave empty.
DATABASE_DNS_SERVERS=
# Set false only when hosting the frontend separately.
SERVE_FRONTEND=true
